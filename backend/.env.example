# Aktaş Mail — backend yapılandırması
# Bu dosyayı `.env` olarak kopyala ve doldur. `.env` git'e GİRMEZ.

NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# PostgreSQL — sunucuda kurulu olan örneğe SSH tüneliyle bağlanılır
DATABASE_URL=postgres://aktasmail:PAROLA@127.0.0.1:5432/aktasmail

# Oturum çerezi imzalama (en az 32 karakter):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=

# Sunucu tarafı sırlar için AES anahtarı — base64url kodlu TAM 32 bayt:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Sadece TOTP gizli anahtarları için kullanılır (giriş sırasında, henüz
# oturum yokken çözülmesi gerekiyor). IMAP parolası bununla DEĞİL,
# istemcideki oturum anahtarıyla şifrelenir — bkz. src/lib/crypto.ts.
# DEĞİŞTİRİLİRSE kayıtlı TOTP kurulumları geçersiz olur.
ENCRYPTION_KEY=

# Dovecot — geliştirmede SSH tüneli üzerinden, üretimde doğrudan yerel
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_SECURE=false

# Postfix submission
SMTP_HOST=127.0.0.1
SMTP_PORT=1587

MAIL_DOMAIN=akts.tr
MAIL_DOMAINS=akts.tr,blankreel.com

# Tarayıcı arayüzünün origin'i — CORS ve çerez kapsamı için
APP_ORIGIN=http://localhost:5173

# Redis — rate limit sayaçları. Üretimde redis://127.0.0.1:6379
# Boş bırakılırsa bellek içi sayaç kullanılır (tek süreçte doğru,
# PM2 çok örnekli çalıştırmada limit bozulur).
REDIS_URL=redis://127.0.0.1:16379
