    "@simplewebauthn/server": "^13.3.2",
    "@types/mailparser": "^3.4.6",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "imapflow": "^1.7.1",
    "ioredis": "^6.0.0",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "onnxruntime-node": "^1.27.0",
    "otplib": "^13.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
